{
  "name": "neural-flow-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "neural-flow — 내 일정 · Google 캘린더 · 구독 LLM 일정 코칭",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/launch.js",
    "check": "node -e \"for (const f of require('fs').readdirSync('main')) require('child_process').execFileSync(process.execPath, ['--check', 'main/' + f])\" && node --check preload.js",
    "dist": "npx --yes electron-builder@26.15.3 --publish never"
  },
  "author": "junsang",
  "license": "MIT",
  "build": {
    "appId": "com.junsang.neuralflow",
    "productName": "neural-flow",
    "artifactName": "neural-flow-${version}-${os}-${arch}.${ext}",
    "files": [
      "main/**",
      "renderer/**",
      "preload.js",
      "assets/**",
      "package.json",
      "build-config.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "../state.json",
        "to": "state.json"
      },
      {
        "from": "../config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "neural-flow"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "publish": null
  },
  "dependencies": {
    "node-ical": "^0.27.2",
    "pretendard": "^1.3.9",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "electron": "^44.4.5"
  },
  "optionalDependencies": {
    "koffi": "^3.3.2"
  }
}
